{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://daig.local/schemas/order-states.json",
  "title": "DAIG Order States",
  "description": "Canonical fulfilment states. Payment, refund and assignment lifecycles are separate schemas.",
  "type": "string",
  "enum": [
    "confirmed",
    "accepted",
    "preparing",
    "packed",
    "rider_assigned",
    "picked_up",
    "delivered",
    "cancelled",
    "delivery_failed"
  ],
  "transitions": {
    "confirmed": ["accepted", "cancelled"],
    "accepted": ["preparing", "cancelled"],
    "preparing": ["packed", "cancelled"],
    "packed": ["rider_assigned", "cancelled"],
    "rider_assigned": ["picked_up", "packed", "cancelled", "delivery_failed"],
    "picked_up": ["delivered", "delivery_failed"],
    "delivered": [],
    "cancelled": [],
    "delivery_failed": []
  },
  "terminal": ["delivered", "cancelled", "delivery_failed"],
  "notes": [
    "Terminal fulfilment states are immutable (ORD-003).",
    "Refunds do not change the terminal fulfilment state; see refund-states.json.",
    "Every transition stores actor, timestamp, source, reason, metadata, correlation ID (ORD-002)."
  ]
}
